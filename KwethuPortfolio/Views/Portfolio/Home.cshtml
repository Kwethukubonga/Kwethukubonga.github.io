      </div>

      <figure class="feature wipe" style="margin-bottom:0">
        <img src="/images/hanbok-wide.webp" alt="Kwethukubonga Kunene at Gyeongbokgung Palace, Seoul">
      </figure>
      <div class="caption meta fade" style="--d:.2s;margin-bottom:clamp(32px,4.6vw,64px)">
        <span>Gyeongbokgung Palace, Seoul</span>
        <span>2025</span>
