@{
    ViewData["Title"] = "Posts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 posts-page">

    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold">Posts</h2>
        <p class="lead text-muted">
            Reflections, milestones, and lessons I share on LinkedIn 
        </p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Post: Golden Key reflection -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 post-card">
                <img src="~/images/goldenkey-2026.jpeg"
                     class="card-img-top rounded-top-4"
                     alt="Golden Key reflection post">

                <div class="card-body">
                    <span class="badge rounded-pill mb-2 post-tag">Academics</span>

                    <h5 class="fw-semibold">Golden Key Reflection: Lessons From 2025</h5>
                    <p class="text-muted small mb-2">January 2026</p>

                    <p>
                        Becoming a member of the Golden Key International Honour Society made me reflect on how
                        full 2025 was — robotics, career exposure, GradStar, and steady growth — with God’s grace.
                    </p>

                    <a href="https://www.linkedin.com/posts/kwethukubonga-kunene-b32118302_goldenkeyinternationalhonoursociety-activity-7420199377085812736-Zz1q?utm_source=share&utm_medium=member_desktop&rcm=ACoAAE1CeVYB9b6mZhRdqUDPVEtWL5t_vWnqgW0"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="post-link">
                        Read on LinkedIn →
                    </a>
                </div>
            </div>
        </div>

        <!-- Post: GradStar Top 100 -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 post-card">
                <img src="~/images/gradstar-2025.jpeg"
                     class="card-img-top rounded-top-4"
                     alt="GradStar Top 100 post">

                <div class="card-body">
                    <span class="badge rounded-pill mb-2 post-tag">Leadership</span>

                    <h5 class="fw-semibold">GradStar Top 100: What the Programme Taught Me</h5>
                    <p class="text-muted small mb-2">December 2025</p>

                    <p>
                        From 7,005 applicants to the final 100, this programme stretched my teamwork,
                        communication, and confidence as we tackled real employer challenges.
                    </p>

                    <a href="https://www.linkedin.com/posts/kwethukubonga-kunene-b32118302_gradstartop100-activity-7403747049562767360-oHWH?utm_source=share&utm_medium=member_desktop&rcm=ACoAAE1CeVYB9b6mZhRdqUDPVEtWL5t_vWnqgW0"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="post-link">
                        Read on LinkedIn →
                    </a>
                </div>
            </div>
        </div>

        <!-- Post: FRC NYC Regional mentoring -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 post-card">
                <img src="~/images/kwethu.jpg"
                     class="card-img-top rounded-top-4"
                     alt="FRC NYC Regional mentoring post">

                <div class="card-body">
                    <span class="badge rounded-pill mb-2 post-tag">Robotics</span>

                    <h5 class="fw-semibold">Mentoring at the FRC NYC Regional</h5>
                    <p class="text-muted small mb-2">April 2025</p>

                    <p>
                        Mentoring Team 10399 at the FRC NYC Regional reminded me why I love robotics.
                        As a rookie international team from South Africa, it was an unforgettable experience.
                    </p>

                    <a href="https://www.linkedin.com/posts/kwethukubonga-kunene-b32118302_firstroboticscompetition-activity-7315860091277082624-05VF?utm_source=share&utm_medium=member_desktop&rcm=ACoAAE1CeVYB9b6mZhRdqUDPVEtWL5t_vWnqgW0"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="post-link">
                        Read on LinkedIn →
                    </a>
