@{
    ViewData["Title"] = "Projects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 projects-page">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold">Projects</h2>
        <p class="lead text-muted">
            Selected work and ongoing projects.
        </p>
    </div>

    <div class="projects-grid">

        <!-- Team 10399 Website (In Progress) -->
        <article class="project project-featured">
            <div class="project-media">
                <img src="~/images/burmanbush-site.jpg" alt="Team 10399 Website preview" />
            </div>

            <div class="project-body">
                <h3 class="project-title">Team 10399 Website (In Progress) </h3>

                <p class="project-sub">
                    A team website I’m actively building for Burman Bush Robotics. It brings together team information,
                    outreach work, and competition updates in one place, and it’s designed to grow with the team.
                </p>

                <div class="project-links">
                    <a class="btn btn-primary-soft"
                       href="https://burmanbush-bzhrcwa5eqeyezd5.southafricanorth-01.azurewebsites.net/"
                       target="_blank" rel="noopener noreferrer">Live Preview</a>

                    <a class="btn btn-outline-soft"
                       href="https://github.com/Kwethukubonga/FRC_Team_Website"
                       target="_blank" rel="noopener noreferrer">GitHub</a>
                </div>

                <div class="stack">
                    <span class="stack-pill">HTML ~68%</span>
                    <span class="stack-pill">CSS ~16%</span>
                    <span class="stack-pill">C# ~15%</span>
                    <span class="stack-pill">JavaScript ~1%</span>
                </div>

                <div class="project-meta">
                    <span class="meta-chip">ASP.NET Core MVC</span>
                    <span class="meta-chip">Azure App Service</span>
                    <span class="meta-chip">Branding + content</span>
                </div>

                <p class="project-note">
                    Temporary site I've created using WordPress:
                    <a class="inline-link" href="https://www.team10399.co.za" target="_blank" rel="noopener noreferrer">
                        www.team10399.co.za →
                    </a>
                </p>
            </div>
        </article>

        <!-- Personal Site -->
        <article class="project">
            <div class="project-media">
                <img src="~/images/cover/cover-scene4.png" alt="Personal site preview" />
            </div>

            <div class="project-body">
                <h3 class="project-title">Personal Site</h3>

                <p class="project-sub">
                    My personal portfolio, built using ASP.NET Core MVC and hosted on Azure. I use it to showcase projects,
                    highlight my academics, and experiment with clean, responsive design as I grow as a developer.
                </p>

                <div class="project-links">
                    <a class="btn btn-outline-soft"
                       href="https://github.com/Kwethukubonga/personal-site"
                       target="_blank" rel="noopener noreferrer">GitHub</a>
                </div>

                <div class="stack">
                    <span class="stack-pill">HTML ~79%</span>
                    <span class="stack-pill">CSS ~11%</span>
                    <span class="stack-pill">C# ~9%</span>
                    <span class="stack-pill">JavaScript ~1%</span>
                </div>

                <div class="project-meta">
                    <span class="meta-chip">ASP.NET Core MVC</span>
                    <span class="meta-chip">Razor Views</span>
                    <span class="meta-chip">Azure Web App</span>
                </div>
            </div>
        </article>

        <!-- Retail Web App -->
        <article class="project">
            <div class="project-media">
                <img src="~/images/webapp.png" alt="Retail Web App preview" />
            </div>

            <div class="project-body">
                <h3 class="project-title">Retail Web App</h3>

                <p class="project-sub">
                    A cloud-based retail web application that manages customers, products, orders, and files. This project
                    gave me hands-on practice using Azure Storage services for real app features like uploads and background processing.
                </p>

                <div class="project-links">
                    <a class="btn btn-outline-soft"
                       href="https://github.com/Kwethukubonga/Retail_WebApp"
                       target="_blank" rel="noopener noreferrer">GitHub</a>
                </div>

                <div class="stack">
                    <span class="stack-pill">C# ~67%</span>
                    <span class="stack-pill">HTML ~29%</span>
                    <span class="stack-pill">CSS ~5%</span>
                    <span class="stack-pill">JavaScript ~0%</span>
                </div>

                <div class="project-meta">
                    <span class="meta-chip">Azure SQL</span>
                    <span class="meta-chip">Blob + Table Storage</span>
                    <span class="meta-chip">Queues + Azure Files</span>
                    <span class="meta-chip">App Service</span>
                </div>
            </div>
        </article>

        <!-- CMCS -->
        <article class="project">
            <div class="project-media">
                <img src="~/images/clean-cmcs.png" alt="CMCS preview" />
            </div>

            <div class="project-body">
                <h3 class="project-title">Contract Monthly Claim System (CMCS)</h3>

                <p class="project-sub">
                    A web-based claim submission and approval system built from a formal brief. It supports role-based workflows
                    for lecturers, coordinators, managers, and HR, with automated calculations, validation, and document uploads.
                </p>

                <div class="project-links">
                    <a class="btn btn-outline-soft"
                       href="https://github.com/Kwethukubonga/CMCS"
                       target="_blank" rel="noopener noreferrer">GitHub</a>
                </div>

                <div class="stack">
                    <span class="stack-pill">C# ~53%</span>
                    <span class="stack-pill">HTML ~44%</span>
                    <span class="stack-pill">CSS ~2%</span>
                    <span class="stack-pill">JavaScript ~0%</span>
                </div>

                <div class="project-meta">
                    <span class="meta-chip">Role-based workflow</span>
                    <span class="meta-chip">Validation + error handling</span>
                    <span class="meta-chip">Document uploads</span>
                    <span class="meta-chip">Unit testing</span>
                </div>
            </div>
        </article>

    </div>
</div>




